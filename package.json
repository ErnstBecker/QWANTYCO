{
  "name": "aurora-support",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src *.ts *.mts *.mjs *.json",
    "format:check": "prettier --check src *.ts *.mts *.mjs *.json",
    "test": "vitest run",
    "test:scenarios": "vitest run src/server/scenarios.test.ts --reporter verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  }
}
