# Model
# Choose one provider: ollama (local, no key) | openai | anthropic.
# MODEL_NAME must be a model of the chosen provider that supports tool calling,
# e.g. qwen2.5:7b-instruct (ollama), gpt-4o-mini (openai), claude-haiku-4-5 (anthropic).
MODEL_PROVIDER=
MODEL_NAME=

# Ollama (only when MODEL_PROVIDER=ollama)
OLLAMA_BASE_URL=

# OpenAI (only when MODEL_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (only when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aurora-support

# Execution limits
TOOL_TIMEOUT_MS=2000
TOOL_MAX_ATTEMPTS=3
TOOL_BACKOFF_MS=200
# 60s fits local CPU inference; 15000-20000 is enough for hosted APIs.
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=1
ACTIVE_BUDGET_MS=120000
GRAPH_RECURSION_LIMIT=15

# Fault injection (demo/testing only; leave empty in normal use)
# JSON with faults consumed in order per tool call: transient | hang | invalid_output | crash
# e.g. {"consultar_chamado":["transient","transient"]}
FAULT_PLAN=
